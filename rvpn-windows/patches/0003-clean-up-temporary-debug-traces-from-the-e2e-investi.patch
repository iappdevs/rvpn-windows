From 539f7fd8fd28bf3e751180ad328e5f98bb557001 Mon Sep 17 00:00:00 2001
From: Amir <gilaniamirhossein@gmail.com>
Date: Sat, 14 Nov 2026 15:13:30 +0330
Subject: [PATCH 3/6] clean up temporary debug traces from the e2e
 investigation

---
 rvpn/crates/rvpn-mobile/src/ws.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/rvpn/crates/rvpn-mobile/src/ws.rs b/rvpn/crates/rvpn-mobile/src/ws.rs
index 1c8c42b..a503c4a 100644
--- a/rvpn/crates/rvpn-mobile/src/ws.rs
+++ b/rvpn/crates/rvpn-mobile/src/ws.rs
@@ -197,7 +197,8 @@ impl<S: AsyncRead + Unpin> MinimalWsReader<S> {
             // establish a connection.
             let before = self.read_buf.len();
             self.reader.read_buf(&mut self.read_buf).await?;
-            if self.read_buf.len() == before {
+            let after = self.read_buf.len();
+            if after == before {
                 // No new bytes and no complete buffered frame: true EOF.
                 anyhow::bail!("Connection closed (EOF)");
             }
