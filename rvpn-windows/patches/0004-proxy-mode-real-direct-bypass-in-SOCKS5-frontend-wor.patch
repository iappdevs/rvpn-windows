+
+/// Relay a bypassed flow directly over the normal internet.
+///
+/// Used when `Socks5ServerConfig::direct_bypass` is set (self-contained
+/// hosts such as the Windows client's proxy mode): the SOCKS5 frontend
+/// itself connects to the target and pipes bytes, so no OS-level routing
+/// tricks are needed for split-tunnel "direct" traffic.
+async fn direct_relay(socket: &mut TcpStream, target_addr: &str) -> Result<()> {
+    let mut outbound = TcpStream::connect(target_addr)
+        .await
+        .with_context(|| format!("[SOCKS5] direct connect to {target_addr} failed"))?;
+    tokio::io::copy_bidirectional(socket, &mut outbound).await?;
+    Ok(())
+}
