 # Android-specific dependencies
 [target.'cfg(target_os = "android")'.dependencies]
 # Android keeps builtin IPs/domains (no 50MB jetsam limit)
@@ -137,6 +143,11 @@ ios-direct-tun = ["rvpn-tls/rustls"]
 # Enable macOS Direct TUN mode (uses same ios_tun implementation as iOS).
 # Selects the boring TLS backend to retain Chrome ClientHello fingerprint mimicry.
 macos-direct-tun = ["rvpn-tls/boring"]
+# Enable Windows Direct TUN mode (uses same ios_tun implementation as iOS).
+# Selects the rustls TLS backend — same stack as the iOS production builds;
+# boring (BoringSSL) would require cmake/nasm to build on Windows MSVC and is
+# not needed for protocol correctness (the protocol requires TLS 1.3 only).
+windows-direct-tun = ["dns", "rustls", "tokio-rustls", "rustls-platform-verifier", "webpki-roots", "tokio-tungstenite/__rustls-tls", "rvpn-tls/rustls"]
 # Enable Android Direct TUN mode (uses android_tun_ffi instead of legacy TunBridge)
 android-direct-tun = ["rustls", "tokio-rustls", "rustls-platform-verifier", "webpki-roots", "tokio-tungstenite/__rustls-tls", "rvpn-tls/rustls"]
 # Enable HarmonyOS NEXT NAPI FFI (uses rustls, same TLS stack as Android).
