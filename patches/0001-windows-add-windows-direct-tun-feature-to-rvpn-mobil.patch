 # macOS keeps builtin IPs/domains (no 50MB NetworkExtension jetsam limit)
 rvpn-split-tunnel = { path = "../rvpn-split-tunnel" }
 
+# Windows-specific dependencies
+# Windows keeps builtin IPs/domains (bypass-country split tunnel data,
+# used by the rvpn-windows desktop client's route setup).
+[target.'cfg(target_os = "windows")'.dependencies]
+rvpn-split-tunnel = { path = "../rvpn-split-tunnel" }
