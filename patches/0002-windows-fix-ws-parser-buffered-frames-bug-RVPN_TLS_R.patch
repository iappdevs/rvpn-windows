         }
+
+        let frame = match opcode {
+            0x02 => {
+                out[..payload_len].copy_from_slice(&self.read_buf[hdr_len..hdr_len + payload_len]);
+                self.read_buf.drain(..frame_end);
+                (FrameType::Binary, payload_len)
+            }
+            0x09 => {
+                out[..payload_len].copy_from_slice(&self.read_buf[hdr_len..hdr_len + payload_len]);
+                self.read_buf.drain(..frame_end);
+                (FrameType::Ping, payload_len)
+            }
+            0x08 => {
+                self.read_buf.drain(..frame_end);
+                (FrameType::Close, 0)
+            }
+            0x0A => {
+                self.read_buf.drain(..frame_end);
