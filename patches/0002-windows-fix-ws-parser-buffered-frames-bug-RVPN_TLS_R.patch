index 59afbe5..c9770d7 100644
--- a/rvpn/crates/rvpn-tls/src/tls_rustls.rs
+++ b/rvpn/crates/rvpn-tls/src/tls_rustls.rs
@@ -129,6 +129,25 @@ fn build_client_config(resumption: Option<&ResumptionStore>) -> Result<Arc<rustl
     let mut root_store = rustls::RootCertStore::empty();
     root_store.extend(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
 
+    // Optional extra roots for self-hosted deployments that terminate TLS
+    // with a private CA or a direct-IP self-signed certificate (no public
+    // CA issues certs for bare IPs). RVPN_TLS_ROOT_CA=/path/to/ca-or-cert.pem
+    // appends every certificate in the PEM to the root store.
+    if let Ok(path) = std::env::var("RVPN_TLS_ROOT_CA") {
+        match std::fs::read(&path) {
+            Ok(pem) => {
+                let certs: Vec<_> = rustls_pemfile::certs(&mut std::io::Cursor::new(&pem))
+                    .collect::<Result<_, _>>()
+                    .context("RVPN_TLS_ROOT_CA: invalid PEM")?;
+                let (added, _) = root_store.add_parsable_certificates(certs);
+                tracing::info!(path, added, "RVPN_TLS_ROOT_CA: appended extra TLS roots");
+            }
+            Err(e) => {
+                tracing::error!("RVPN_TLS_ROOT_CA is set but unreadable ({path}): {e}");
+            }
+        }
+    }
+
     // Build a Chrome-order CryptoProvider on top of the ring provider so the
     // ClientHello's cipher_suites and kx_groups lists match Chrome-on-TLS-1.3.
     //
