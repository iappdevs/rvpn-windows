+
+#[cfg(test)]
+mod frame_stream_tests {
+    use super::*;
+
+    /// Frames delivered back-to-back in ONE TCP segment must all be parsed —
+    /// including a Ping landing between two Binaries (the production relay
+    /// sees exactly this after a server keepalive).
+    #[tokio::test]
+    async fn next_frame_parses_back_to_back_frames_in_one_segment() {
+        use tokio::io::AsyncWriteExt;
+
+        let (mut fake_wire, our_side) = tokio::io::duplex(4096);
+        let (our_read, _our_write) = tokio::io::split(our_side);
+        let mut reader = MinimalWsReader {
+            reader: our_read,
+            read_buf: Vec::new(),
+        };
+
+        // binary("abc") + ping(2 bytes) + binary("de")
+        let mut data = vec![0x82, 0x03, b'a', b'b', b'c'];
+        data.extend_from_slice(&[0x89, 0x02, 0x11, 0x22]);
+        data.extend_from_slice(&[0x82, 0x02, b'd', b'e']);
+        fake_wire.write_all(&data).await.unwrap();
+        drop(fake_wire); // EOF after the frames — parser must not need more bytes
+
+        let mut out = vec![0u8; 256];
+        let (t1, n1) = reader.next_frame(&mut out).await.expect("frame 1");
+        assert_eq!((t1, n1), (FrameType::Binary, 3));
+        assert_eq!(&out[..n1], b"abc");
+
+        let (t2, n2) = reader.next_frame(&mut out).await.expect("frame 2");
+        assert_eq!((t2, n2), (FrameType::Ping, 2));
+
+        let (t3, n3) = reader.next_frame(&mut out).await.expect("frame 3");
+        assert_eq!((t3, n3), (FrameType::Binary, 2));
+        assert_eq!(&out[..n3], b"de");
+    }
+}
